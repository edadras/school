APP_NAME="School Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=school
DB_USERNAME=school
DB_PASSWORD=change-me
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Platform ---------------------------------------------------------------
# First super-admin: `php artisan platform:create-admin you@example.com` (password is prompted, never stored here).
TRUSTED_PROXIES=
# Browser origin(s) allowed to call the API cross-origin (empty = same-origin only), comma separated.
CORS_ALLOWED_ORIGINS=
# Public school registration attempts per IP per hour
REGISTER_PER_HOUR=5

# --- Private files: FILES_DISK=s3 for an S3-compatible bucket (MinIO in docker-compose) with NO public access ---
FILES_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=school-private
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Live classes: SFU adapter (NOT configured => feature reports 'unconfigured', never fakes it) ---
MEDIA_PROVIDER=none
LIVEKIT_URL=
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TURN_URL=
TURN_SECRET=

# --- AI provider adapter (none => disabled): none | anthropic | openai ---
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# --- Push (FCM v1). Unset => push deliveries are reported 'unconfigured'. Path to the service-account JSON, never committed ---
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# --- Realtime (Laravel Reverb WebSocket) ---
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# --- Malware scan on upload: none | clamav (clamd over TCP or unix socket). Unset => files stored with scan_status=skipped ---
SCAN_PROVIDER=none
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_SOCKET=
SCAN_FAIL_CLOSED=true

# --- Recording (LiveKit Egress + S3-compatible bucket). All three set => recording available; otherwise "unconfigured" ---
EGRESS_S3_BUCKET=
EGRESS_S3_ACCESS_KEY=
EGRESS_S3_SECRET=
EGRESS_S3_REGION=
EGRESS_S3_ENDPOINT=
EGRESS_S3_PATH_STYLE=false
EGRESS_FILES_DISK=s3
# Self-hosted recording template served by the web container (no dependency on egress-composite.livekit.io)
EGRESS_TEMPLATE_URL=https://YOUR-HOST/egress-template/index.html
